# Text is stored with LF in the repository; each checkout uses its platform's line endings.
* text=auto

# Scripts that must keep one ending whatever the platform.
*.sh text eol=lf
android/gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.bmp binary
*.icns binary
*.glb binary
*.blend binary
*.jar binary
*.woff2 binary

# GitHub's language stats and diffs.
package-lock.json linguist-generated=true -diff

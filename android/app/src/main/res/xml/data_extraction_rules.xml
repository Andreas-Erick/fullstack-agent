<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app leaves the phone in a cloud backup or a transfer to a new phone: the device token
     (Keystore copy and the page's own) must not work anywhere else; pair the new phone instead.
     "root" alone covers the WebView's storage (app_webview); the other domains are belt and braces. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

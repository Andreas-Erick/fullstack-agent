{
  "name": "siren-assistant",
  "productName": "Siren Assistant",
  "version": "2.3.0",
  "description": "Siren Assistant: a personal AI assistant for Windows and macOS with voice, memory, a vault of notes, learning and habit coaching, an animated face and a phone app.",
  "main": "main/main.js",
  "author": "Andreas Erick",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "test": "node scripts/test.js",
    "test:browser": "node scripts/test.js --browser",
    "smoke": "electron . --smoke",
    "recover": "node scripts/recover.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "release:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "phonemizer": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nexus.agent",
    "productName": "Siren Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "assets/**",
      "renderer/**",
      "preload.js",
      "package.json",
      "node_modules/**",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/onnxruntime-web/**",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.*",
      "scripts/**",
      "test/**",
      "docs/ENGINEERING.md",
      "CLAUDE.md",
      "TROUBLESHOOTING.md",
      "README.md",
      "PRIVACY.md",
      "CHANGELOG.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Siren Assistant listens when you talk to it (push-to-talk or hands-free).",
        "NSScreenCaptureUsageDescription": "Siren Assistant sees your screen only while you share it.",
        "NSAppleEventsUsageDescription": "Siren Assistant can open documents and windows for you."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Siren Assistant",
      "artifactName": "Siren-Assistant-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Andreas-Erick",
        "repo": "fullstack-agent",
        "releaseType": "release"
      }
    ],
    "artifactName": "Siren-Assistant-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Siren Assistant",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "runAfterFinish": true,
      "artifactName": "Siren-Assistant-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "Siren-Assistant-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Siren-Assistant-${version}-portable.${ext}"
    },
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": false,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Andreas-Erick/fullstack-agent.git"
  }
}

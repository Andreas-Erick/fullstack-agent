{
  "name": "nexus-agent",
  "productName": "Nexus Agent",
  "version": "1.3.0",
  "description": "Personal AI assistant desktop app: streaming chat, voice, memory vault, living circuit-board face, Google Calendar, Obsidian knowledge base and document viewer.",
  "main": "main/main.js",
  "author": "Andreas Erick",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "test": "node scripts/test.js",
    "recover": "node scripts/recover.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "release:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "dompurify": "^3.4.17",
    "katex": "^0.16.22",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "phonemizer": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nexus.agent",
    "productName": "Nexus Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "assets/**",
      "renderer/**",
      "preload.js",
      "package.json",
      "node_modules/**",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/onnxruntime-web/**",
      "scripts/**",
      "test/**",
      "docs/ENGINEERING.md",
      "CLAUDE.md",
      "TROUBLESHOOTING.md",
      "README.md",
      "PRIVACY.md",
      "CHANGELOG.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nexus Agent uses the microphone for push-to-talk voice input."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Andreas-Erick",
        "repo": "fullstack-agent",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Agent",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Andreas-Erick/fullstack-agent.git"
  }
}
